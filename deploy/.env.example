# Public DNS hostname only, without https://
CASHBOOK_DOMAIN=cashbook.example.com
# Generate with: openssl rand -hex 32 (hex is safe within the database DSN)
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
CASHBOOK_AWS_REGION=ap-south-1
CASHBOOK_S3_BUCKET=REPLACE_WITH_PRIVATE_MEDIA_BUCKET
CASHBOOK_BACKUP_BUCKET=REPLACE_WITH_PRIVATE_BACKUP_BUCKET
# No mock codes in production. Admin can reset passwords until SNS is approved.
CASHBOOK_SMS_PROVIDER=disabled

# Optional: use existing bucket folders; leave media prefix empty for original layout.
CASHBOOK_S3_PREFIX=
CASHBOOK_BACKUP_PREFIX=backups
