{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PrivateCashbookAttachments",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::REPLACE_MEDIA_BUCKET/attatchments/images/*", "arn:aws:s3:::REPLACE_MEDIA_BUCKET/attatchments/voice_notes/*"]
    },
    {
      "Sid": "AppendBackups",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::REPLACE_BACKUP_BUCKET/pg_dump/*"
    }
  ]
}
