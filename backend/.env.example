# Copy to .env and adjust. Never commit .env.
# Local development uses the mock SMS provider; it cannot be selected in production configuration.
CASHBOOK_ENV=local
CASHBOOK_DB_DSN=postgresql://postgres:cashbook_local@localhost:5433/cashbook_dev
CASHBOOK_SESSION_TTL_MINUTES=720
CASHBOOK_UPLOAD_DIR=./local_uploads
CASHBOOK_SMS_PROVIDER=mock
CASHBOOK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
